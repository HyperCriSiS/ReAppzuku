<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/policy_editor_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/policy_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textIsSelectable="true" />

        <TextView
            style="@style/PolicyEditorLabel"
            android:labelFor="@id/policy_preset"
            android:text="@string/policy_editor_preset" />

        <Spinner
            android:id="@+id/policy_preset"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            style="@style/PolicyEditorLabel"
            android:labelFor="@id/policy_strategy"
            android:text="@string/policy_editor_strategy" />

        <Spinner
            android:id="@+id/policy_strategy"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            style="@style/PolicyEditorLabel"
            android:text="@string/policy_editor_smart_delays" />

        <EditText
            android:id="@+id/policy_standby_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/policy_editor_standby_minutes"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/policy_force_stop_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/policy_editor_force_stop_minutes"
            android:inputType="numberSigned"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/policy_editor_never_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <TextView
            style="@style/PolicyEditorLabel"
            android:labelFor="@id/policy_kill_method"
            android:text="@string/policy_editor_kill_method" />

        <Spinner
            android:id="@+id/policy_kill_method"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            style="@style/PolicyEditorLabel"
            android:labelFor="@id/policy_background_restriction"
            android:text="@string/policy_editor_background_restriction" />

        <Spinner
            android:id="@+id/policy_background_restriction"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <CheckBox
            android:id="@+id/policy_boot_cleanup"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_boot_cleanup" />

        <TextView
            style="@style/PolicyEditorLabel"
            android:text="@string/policy_editor_protection" />

        <CheckBox
            android:id="@+id/policy_protect_media"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_protect_media" />

        <CheckBox
            android:id="@+id/policy_protect_fgs"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_protect_fgs" />

        <CheckBox
            android:id="@+id/policy_protect_widgets"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_protect_widgets" />

        <TextView
            style="@style/PolicyEditorLabel"
            android:text="@string/policy_editor_triggers" />

        <CheckBox
            android:id="@+id/policy_trigger_periodic"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_trigger_periodic" />

        <CheckBox
            android:id="@+id/policy_trigger_screen_off"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_trigger_screen_off" />

        <CheckBox
            android:id="@+id/policy_trigger_ram"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_trigger_ram" />

        <CheckBox
            android:id="@+id/policy_trigger_boot"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_trigger_boot" />

        <CheckBox
            android:id="@+id/policy_trigger_hardware"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_trigger_hardware" />

        <CheckBox
            android:id="@+id/policy_trigger_app_launch"
            style="@style/PolicyEditorCheck"
            android:text="@string/policy_editor_trigger_app_launch" />

        <Button
            android:id="@+id/policy_save_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/policy_editor_save_as_preset" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/policy_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/cancel" />

            <Button
                android:id="@+id/policy_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/policy_editor_save" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
